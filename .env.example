# Supabase > Project Settings > Database > Connection string. Use the pooler host for both (the direct
# db.<ref>.supabase.co host is IPv6-only).
# Transaction pooler (port 6543) for the app at runtime:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Session pooler (port 5432) for Prisma CLI (db push / migrations):
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth (Project Settings > API Keys). URL + publishable key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only admin key, required at runtime by account deletion (DELETE /api/account). Never prefix with
# NEXT_PUBLIC_; set it in Vercel as a sensitive environment variable.
SUPABASE_SECRET_KEY=""

# AI providers (PRD 18: only providers that don't train on submitted code). Tried in order:
#   1. OpenRouter, paid model, zero-data-retention endpoints only (enforced in code; ":free" models are refused)
#   2. Groq
# If both fail, reviews fall back to static-analysis results. Gemini is not used.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Random string mixed into the hashed rate-limit key (client IP for guests, account id for users).
RATE_LIMIT_SALT=""
