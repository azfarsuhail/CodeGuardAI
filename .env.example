# Supabase > Project Settings > Database > Connection string
# Pooled (Supavisor, port 6543) for the app at runtime:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) for Prisma CLI migrations:
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# AI providers, tried in order: OpenRouter -> Groq -> Gemini (-> Gemini lite). Set at least one.
# Privacy (PRD 18): OpenRouter :free routes and Gemini's free tier may train on prompts; Groq's API terms don't.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
# "true" = only zero-data-retention, no-training OpenRouter endpoints (free models have none: requests fall to Groq).
OPENROUTER_ZDR="false"
GROQ_API_KEY=""
GEMINI_API_KEY=""
# Optional model overrides.
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# Random string mixed into the hashed client IP used for the guest rate limit.
RATE_LIMIT_SALT=""
