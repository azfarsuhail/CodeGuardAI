    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@typescript-eslint/parser": "^8.71.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "globals": "^17.13.0",
    "java-parser": "^3.0.1",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
