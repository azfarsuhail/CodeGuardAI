{
  "name": "codeguard-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test src/**/*.test.ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push && prisma db execute --file prisma/rls.sql",
